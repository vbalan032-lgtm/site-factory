    "03-conversion-copy": {"summary_tokens": 900, "exact_tokens": 500, "total_tokens": 1600, "top_k": 8},
    "04-page-assets": {"summary_tokens": 500, "exact_tokens": 300, "total_tokens": 1000, "top_k": 6},
    "05-full-page-build": {"summary_tokens": 700, "exact_tokens": 500, "total_tokens": 1400, "top_k": 8},
    "06-integrated-qa-refinement": {"summary_tokens": 900, "exact_tokens": 700, "total_tokens": 1800, "top_k": 10},
    "07-release-growth": {"summary_tokens": 400, "exact_tokens": 500, "total_tokens": 900, "top_k": 6}
  }
}
