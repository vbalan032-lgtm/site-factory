{
  "schema_version": "1.1",
  "project_id": "example-site",
  "provider": "graphify-json",
  "provider_settings_ref": null,
  "extraction_mode": "code-only",
  "knowledge_seed_paths": ["docs/system/knowledge-graph/PROJECT_KNOWLEDGE.json"],
  "corpus_roots": [
    "PROJECT_MASTER_CONTEXT.md",
    "docs/BRAND_STYLE.md",
    "docs/PRODUCT_MAP.md",
    "docs/CLAIMS_AND_PROOFS.md",
    "docs/PERSONAS.md",
    "docs/BUSINESS_ARCHITECTURE.md",
    "docs/SITEMAP.md",
    "docs/pages",
    "docs/site",
    "docs/system",
    "app",
    "components",
    "lib"
  ],
  "corpus_rules": [
    {"root": "PROJECT_MASTER_CONTEXT.md", "source_role": "canonical", "stages": ["01-page-contract", "02-creative-blueprint", "03-conversion-copy", "04-page-assets", "05-full-page-build", "06-integrated-qa-refinement", "07-release-growth"], "index_mode": "sections"},
    {"root": "docs/BRAND_STYLE.md", "source_role": "design", "stages": ["01-page-contract", "02-creative-blueprint", "03-conversion-copy", "04-page-assets", "05-full-page-build", "06-integrated-qa-refinement", "07-release-growth"], "index_mode": "sections"},
    {"root": "docs/PRODUCT_MAP.md", "source_role": "canonical", "stages": ["01-page-contract", "02-creative-blueprint", "03-conversion-copy", "04-page-assets", "05-full-page-build", "06-integrated-qa-refinement", "07-release-growth"], "index_mode": "sections"},
    {"root": "docs/CLAIMS_AND_PROOFS.md", "source_role": "canonical", "stages": ["01-page-contract", "03-conversion-copy", "06-integrated-qa-refinement", "07-release-growth"], "index_mode": "sections"},
    {"root": "docs/PERSONAS.md", "source_role": "canonical", "stages": ["01-page-contract", "02-creative-blueprint", "03-conversion-copy", "06-integrated-qa-refinement"], "index_mode": "sections"},
    {"root": "docs/BUSINESS_ARCHITECTURE.md", "source_role": "canonical", "stages": ["01-page-contract", "02-creative-blueprint", "03-conversion-copy", "06-integrated-qa-refinement", "07-release-growth"], "index_mode": "sections"},
    {"root": "docs/SITEMAP.md", "source_role": "canonical", "stages": ["01-page-contract", "02-creative-blueprint", "03-conversion-copy", "04-page-assets", "05-full-page-build", "06-integrated-qa-refinement", "07-release-growth"], "index_mode": "sections"},
    {"root": "docs/pages", "source_role": "page_artifact", "stages": ["01-page-contract", "02-creative-blueprint", "03-conversion-copy", "04-page-assets", "05-full-page-build", "06-integrated-qa-refinement", "07-release-growth"], "index_mode": "sections"},
    {"root": "docs/site", "source_role": "lifecycle", "stages": ["01-page-contract", "02-creative-blueprint", "03-conversion-copy", "04-page-assets", "05-full-page-build", "06-integrated-qa-refinement", "07-release-growth"], "index_mode": "sections"},
    {"root": "docs/system", "source_role": "lifecycle", "stages": ["01-page-contract", "02-creative-blueprint", "03-conversion-copy", "04-page-assets", "05-full-page-build", "06-integrated-qa-refinement", "07-release-growth"], "index_mode": "sections"},
