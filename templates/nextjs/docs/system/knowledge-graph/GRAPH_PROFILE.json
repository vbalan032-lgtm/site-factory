    {"root": "components", "source_role": "implementation", "stages": ["05-full-page-build", "06-integrated-qa-refinement", "07-release-growth"], "index_mode": "code-symbols"},
    {"root": "lib", "source_role": "implementation", "stages": ["05-full-page-build", "06-integrated-qa-refinement", "07-release-growth"], "index_mode": "code-symbols"}
